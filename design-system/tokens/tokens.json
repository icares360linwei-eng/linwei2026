{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "源裕兴设计系统全典 · Design Tokens",
  "$version": "38.0.0",
  "$edition": "原子设计版 · Atomic Edition",
  "$philosophy": "守正 · 开物 · 共生",
  "$description": "唯一可信源（Single Source of Truth）。Layer 0 Primitive 只定义一次；Layer 1 Semantic 只引用 Primitive；Layer 2 Component 只引用 Semantic。五实体主题只替换 entity.* 映射，暗色模式只替换 Semantic。任何组件 CSS 不得出现字面色值或魔法数字。",
  "$authority": {
    "colorStandard": "V6.0 五实体主色为唯一权威（#851EA3 / #196B42 / #1E4082 / #208F9B / #B81E1E），600 阶锚定原值不漂移，其余阶由 OKLCH 推导。",
    "neutral": "宣纸白九阶 Ink（V37 原值不变）",
    "gold": "藤黄 #C9A96E（V37 原值不变）"
  },

  "primitive": {
    "color": {
      "ink": {
        "$type": "color",
        "$description": "宣纸白九阶 · 带暖色相偏移的中性色，禁止纯黑纯白",
        "50":  { "$value": "#FFFBF5", "$extensions": { "sino.name": "宣纸白" } },
        "100": { "$value": "#FAF7F2", "$extensions": { "sino.name": "轻霜" } },
        "200": { "$value": "#F0EBE3", "$extensions": { "sino.name": "薄雾" } },
        "300": { "$value": "#D9D3C8", "$extensions": { "sino.name": "淡烟" } },
        "400": { "$value": "#BFB8AB", "$extensions": { "sino.name": "古绢" } },
        "500": { "$value": "#8C8578", "$extensions": { "sino.name": "中灰" } },
        "600": { "$value": "#6B6459", "$extensions": { "sino.name": "砚灰" } },
        "700": { "$value": "#4A443C", "$extensions": { "sino.name": "墨灰" } },
        "800": { "$value": "#2D2823", "$extensions": { "sino.name": "浓墨" } },
        "900": { "$value": "#1A1612", "$extensions": { "sino.name": "玄墨" } }
      },
      "entity": {
        "$type": "color",
        "$description": "五实体主色锚点（600 阶）。构建时以 OKLCH 推导 50–900 十阶，锚点原值锁定。",
        "stg": { "$value": "#851EA3", "$extensions": { "sino.name": "绛紫", "sino.entity": "STG", "sino.full": "源裕兴集团母体", "sino.role": "战略中枢 · 合规治理", "sino.meaning": "包容万象、多元统一" } },
        "ste": { "$value": "#196B42", "$extensions": { "sino.name": "苍木绿", "sino.entity": "STE", "sino.full": "九派能源", "sino.role": "清洁能源 · 碳中和", "sino.meaning": "生生不息、自然循环" } },
        "sti": { "$value": "#1E4082", "$extensions": { "sino.name": "深空蓝", "sino.entity": "STI", "sino.full": "进出口贸易", "sino.role": "全球贸易 · 报关物流", "sino.meaning": "深远的全球视野" } },
        "sth": { "$value": "#208F9B", "$extensions": { "sino.name": "沧浪青", "sino.entity": "STH", "sino.full": "健康科技", "sino.role": "医疗器械 · 健康监测", "sino.meaning": "澄澈通透的生命质感" } },
        "edu": { "$value": "#B81E1E", "$extensions": { "sino.name": "朱砂红", "sino.entity": "EDU", "sino.full": "崇仁教育", "sino.role": "教育启智 · 家校协同", "sino.meaning": "炽热的教育初心" } }
      },
      "gold": {
        "$type": "color",
        "$description": "藤黄 · 署名与点睛。戒律：只做小面积署名、金线与承载深色文字的 CTA 底；永不做浅底上的文字色。",
        "$value": "#C9A96E",
        "$extensions": { "sino.name": "藤黄", "sino.anchorStep": "400" }
      }
    },

    "font": {
      "$type": "fontFamily",
      "display": { "$value": "'LXGW WenKai TC', 'LXGW WenKai', 'Noto Serif SC', 'Songti SC', serif", "$extensions": { "sino.name": "霞鹜文楷", "sino.use": "Logo / Hero / 品牌标题" } },
      "serif":   { "$value": "'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'SimSun', serif", "$extensions": { "sino.name": "思源宋体", "sino.use": "中文正文 / 引文 / 章节标题" } },
      "sans":    { "$value": "'Noto Sans SC', 'Source Han Sans SC', 'PingFang SC', 'Microsoft YaHei', 'Inter', system-ui, sans-serif", "$extensions": { "sino.name": "思源黑体", "sino.use": "中文 UI / 界面" } },
      "western": { "$value": "'Inter', 'Noto Sans SC', system-ui, sans-serif", "$extensions": { "sino.name": "Inter", "sino.use": "西文正文 / UI" } },
      "mono":    { "$value": "'JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, 'Noto Sans SC', monospace", "$extensions": { "sino.name": "JetBrains Mono", "sino.use": "代码 / 数据 / Token" } }
    },

    "type": {
      "$description": "15 级字阶（基准 16px）。力起·秀承：Display/H1 用力（大、紧），H2 以下用秀（阶梯缓、行高舒）。V38 修正：H4 由 28px 改为 22px 使阶梯单调；Body L 行高 1.60→1.80（长文卷舒）。",
      "display-l": { "size": 72, "lh": 1.08, "weight": 200, "family": "serif", "ls": "-0.02em", "fluidMin": 44, "use": "首页 Hero" },
      "display-m": { "size": 60, "lh": 1.10, "weight": 200, "family": "serif", "ls": "-0.015em", "fluidMin": 38, "use": "次级 Hero" },
      "display-s": { "size": 42, "lh": 1.12, "weight": 300, "family": "serif", "ls": "-0.01em", "fluidMin": 30, "use": "小型展示标题" },
      "h1":        { "size": 36, "lh": 1.15, "weight": 300, "family": "serif", "ls": "-0.01em", "fluidMin": 28, "use": "页面标题" },
      "h2":        { "size": 30, "lh": 1.20, "weight": 400, "family": "serif", "ls": "0.01em", "use": "章标题" },
      "h3":        { "size": 24, "lh": 1.25, "weight": 400, "family": "serif", "ls": "0.01em", "use": "节标题" },
      "h4":        { "size": 22, "lh": 1.30, "weight": 500, "family": "serif", "ls": "0", "use": "子区块标题" },
      "h5":        { "size": 20, "lh": 1.35, "weight": 500, "family": "sans", "ls": "0", "use": "卡片标题" },
      "h6":        { "size": 18, "lh": 1.40, "weight": 500, "family": "sans", "ls": "0", "use": "小标题" },
      "body-l":    { "size": 16, "lh": 1.80, "weight": 400, "family": "sans", "ls": "0", "use": "正文阅读（长文用 serif）" },
      "body-m":    { "size": 15, "lh": 1.70, "weight": 400, "family": "sans", "ls": "0", "use": "界面文字" },
      "body-s":    { "size": 14, "lh": 1.75, "weight": 400, "family": "sans", "ls": "0", "use": "辅助文字" },
      "caption":   { "size": 12, "lh": 1.60, "weight": 400, "family": "sans", "ls": "0.01em", "use": "标签 / 说明" },
      "caption-xs":{ "size": 10, "lh": 1.50, "weight": 500, "family": "sans", "ls": "0.06em", "use": "法律文本 / 眼标（仅印刷与法务）" },
      "code":      { "size": 13, "lh": 1.70, "weight": 400, "family": "mono", "ls": "0", "use": "代码行内 / Token" }
    },

    "space": {
      "$type": "dimension",
      "$description": "4px 基准 · 12 级",
      "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px",
      "7": "40px", "8": "48px", "9": "56px", "10": "64px", "11": "80px", "12": "96px"
    },

    "radius": {
      "$type": "dimension",
      "$description": "7 级圆角 · 同心圆角铁律：外圆角 = 内圆角 + 内边距",
      "xs": "2px", "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "2xl": "24px", "full": "9999px"
    },

    "motion": {
      "duration": {
        "$type": "duration",
        "instant": "100ms", "fast": "150ms", "base": "300ms", "slow": "500ms", "loop": "2000ms",
        "exit-fast": "100ms", "exit-base": "200ms", "exit-slow": "320ms"
      },
      "easing": {
        "$type": "cubicBezier",
        "out":      "cubic-bezier(.16, 1, .3, 1)",
        "in":       "cubic-bezier(.4, 0, 1, 1)",
        "standard": "cubic-bezier(.2, 0, 0, 1)",
        "elegant":  "cubic-bezier(.25, .1, .25, 1)",
        "spring":   "cubic-bezier(.34, 1.18, .64, 1)",
        "linear":   "linear"
      }
    },

    "z": {
      "$type": "number",
      "dropdown": 100, "sticky": 200, "fixed": 300, "drawer": 400, "modal": 500, "popover": 600, "tooltip": 700, "toast": 800
    },

    "breakpoint": {
      "$type": "dimension",
      "xs": { "min": 0,    "max": 599,  "cols": 4,  "gutter": "16px", "margin": "16px", "device": "手机竖屏" },
      "sm": { "min": 600,  "max": 904,  "cols": 8,  "gutter": "16px", "margin": "24px", "device": "手机横屏 / 小平板" },
      "md": { "min": 905,  "max": 1239, "cols": 12, "gutter": "24px", "margin": "32px", "device": "平板 / 小笔记本" },
      "lg": { "min": 1240, "max": 1439, "cols": 12, "gutter": "24px", "margin": "40px", "device": "桌面显示器" },
      "xl": { "min": 1440, "max": null, "cols": 12, "gutter": "24px", "margin": "auto", "device": "大屏（内容区 max 1200px）" }
    },

    "grid": { "columns": 12, "maxWidth": "1200px", "nestingMax": 3 },
    "icon": { "canvas": "24px", "stroke": "2px", "corner": "2px", "sizes": ["18px", "20px", "24px", "48px"], "touchTarget": "44px" }
  },

  "entityMapping": {
    "$description": "五实体切换只替换这一组 --e-* 映射。--e-primary-light 由构建脚本按 WCAG AA（≥4.5:1 对 Ink 50）从 600 阶起向下选取；--e-primary-dark 从 300 阶起向上选取（≥4.5:1 对 Ink 800 且 Ink 900 文字 ≥4.5:1）。"
  },

  "semantic": {
    "color": {
      "light": {
        "background":          "{primitive.color.ink.100}",
        "onBackground":        "{primitive.color.ink.900}",
        "surface":             "{primitive.color.ink.50}",
        "surfaceVariant":      "{primitive.color.ink.200}",
        "surfaceContainer":    "{primitive.color.ink.100}",
        "surfaceHover":        "color-mix(in oklab, {primitive.color.ink.900} 4%, {primitive.color.ink.50})",
        "onSurface":           "{primitive.color.ink.800}",
        "onSurfaceStrong":     "{primitive.color.ink.900}",
        "onSurfaceVariant":    "{primitive.color.ink.600}",
        "onSurfaceMuted":      "{primitive.color.ink.500}",
        "placeholder":         "{primitive.color.ink.600}",
        "outline":             "{primitive.color.ink.500}",
        "outlineVariant":      "{primitive.color.ink.300}",
        "outlineFaint":        "{primitive.color.ink.200}",
        "brand":               "{entity.600}",
        "primary":             "{entity.primary-light}",
        "onPrimary":           "{primitive.color.ink.50}",
        "primaryHover":        "{entity.700}",
        "primaryActive":       "{entity.800}",
        "primaryContainer":    "{entity.100}",
        "onPrimaryContainer":  "{entity.800}",
        "primarySubtle":       "{entity.50}",
        "primaryFixed":        "{entity.200}",
        "secondary":           "{primitive.color.ink.700}",
        "onSecondary":         "{primitive.color.ink.50}",
        "secondaryContainer":  "{primitive.color.ink.200}",
        "onSecondaryContainer":"{primitive.color.ink.800}",
        "tertiary":            "{primitive.color.gold.400}",
        "onTertiary":          "{primitive.color.ink.900}",
        "tertiaryContainer":   "{primitive.color.gold.100}",
        "onTertiaryContainer": "{primitive.color.gold.800}",
        "gold":                "{primitive.color.gold.400}",
        "goldLine":            "{primitive.color.gold.500}",
        "goldText":            "{primitive.color.gold.700}",
        "vermilion":           "{primitive.color.entity.edu.600}",
        "success":             "{primitive.color.entity.ste.600}",
        "onSuccess":           "{primitive.color.ink.50}",
        "successContainer":    "{primitive.color.entity.ste.100}",
        "onSuccessContainer":  "{primitive.color.entity.ste.800}",
        "warning":             "{primitive.color.gold.700}",
        "onWarning":           "{primitive.color.ink.50}",
        "warningContainer":    "{primitive.color.gold.100}",
        "onWarningContainer":  "{primitive.color.gold.800}",
        "error":               "{primitive.color.entity.edu.600}",
        "onError":             "{primitive.color.ink.50}",
        "errorContainer":      "{primitive.color.entity.edu.100}",
        "onErrorContainer":    "{primitive.color.entity.edu.800}",
        "info":                "{primitive.color.entity.sti.600}",
        "onInfo":              "{primitive.color.ink.50}",
        "infoContainer":       "{primitive.color.entity.sti.100}",
        "onInfoContainer":     "{primitive.color.entity.sti.800}",
        "link":                "{entity.primary-light}",
        "linkHover":           "{entity.800}",
        "focusRing":           "{entity.primary-light}",
        "focusHalo":           "color-mix(in oklab, {entity.primary-light} 22%, transparent)",
        "selectedBg":          "color-mix(in oklab, {entity.primary-light} 7%, {primitive.color.ink.50})",
        "selectedBorder":      "{entity.primary-light}",
        "scrim":               "color-mix(in oklab, {primitive.color.ink.900} 48%, transparent)",
        "inverseSurface":      "{primitive.color.ink.900}",
        "inverseOnSurface":    "{primitive.color.ink.100}",
        "inversePrimary":      "{entity.300}",
        "skeleton":            "{primitive.color.ink.200}",
        "skeletonShine":       "{primitive.color.ink.100}",
        "chartGrid":           "{primitive.color.ink.200}",
        "chartAxis":           "{primitive.color.ink.400}",
        "chartMuted":          "{primitive.color.ink.500}",
        "chartSurface":        "{primitive.color.ink.50}",
        "chartEmphasisDim":    "{primitive.color.ink.300}",
        "series1":             "{primitive.color.chart.1}",
        "series2":             "{primitive.color.chart.2}",
        "series3":             "{primitive.color.chart.3}",
        "series4":             "{primitive.color.chart.4}",
        "series5":             "{primitive.color.chart.5}",
        "series6":             "{primitive.color.chart.6}"
      },
      "dark": {
        "background":          "{primitive.color.ink.900}",
        "onBackground":        "{primitive.color.ink.100}",
        "surface":             "{primitive.color.ink.800}",
        "surfaceVariant":      "{primitive.color.ink.700}",
        "surfaceContainer":    "color-mix(in oklab, {primitive.color.ink.800} 60%, {primitive.color.ink.900})",
        "surfaceHover":        "color-mix(in oklab, {primitive.color.ink.50} 6%, {primitive.color.ink.800})",
        "onSurface":           "{primitive.color.ink.100}",
        "onSurfaceStrong":     "{primitive.color.ink.50}",
        "onSurfaceVariant":    "{primitive.color.ink.300}",
        "onSurfaceMuted":      "{primitive.color.ink.400}",
        "placeholder":         "{primitive.color.ink.400}",
        "outline":             "{primitive.color.ink.500}",
        "outlineVariant":      "{primitive.color.ink.600}",
        "outlineFaint":        "{primitive.color.ink.700}",
        "brand":               "{entity.300}",
        "primary":             "{entity.primary-dark}",
        "onPrimary":           "{primitive.color.ink.900}",
        "primaryHover":        "{entity.200}",
        "primaryActive":       "{entity.100}",
        "primaryContainer":    "{entity.800}",
        "onPrimaryContainer":  "{entity.100}",
        "primarySubtle":       "color-mix(in oklab, {entity.800} 45%, {primitive.color.ink.800})",
        "primaryFixed":        "{entity.700}",
        "secondary":           "{primitive.color.ink.200}",
        "onSecondary":         "{primitive.color.ink.900}",
        "secondaryContainer":  "{primitive.color.ink.700}",
        "onSecondaryContainer":"{primitive.color.ink.100}",
        "tertiary":            "{primitive.color.gold.300}",
        "onTertiary":          "{primitive.color.ink.900}",
        "tertiaryContainer":   "{primitive.color.gold.800}",
        "onTertiaryContainer": "{primitive.color.gold.100}",
        "gold":                "{primitive.color.gold.300}",
        "goldLine":            "{primitive.color.gold.400}",
        "goldText":            "{primitive.color.gold.300}",
        "vermilion":           "{primitive.color.entity.edu.300}",
        "success":             "{primitive.color.entity.ste.300}",
        "onSuccess":           "{primitive.color.ink.900}",
        "successContainer":    "{primitive.color.entity.ste.800}",
        "onSuccessContainer":  "{primitive.color.entity.ste.100}",
        "warning":             "{primitive.color.gold.300}",
        "onWarning":           "{primitive.color.ink.900}",
        "warningContainer":    "{primitive.color.gold.800}",
        "onWarningContainer":  "{primitive.color.gold.100}",
        "error":               "{primitive.color.entity.edu.300}",
        "onError":             "{primitive.color.ink.900}",
        "errorContainer":      "{primitive.color.entity.edu.800}",
        "onErrorContainer":    "{primitive.color.entity.edu.100}",
        "info":                "{primitive.color.entity.sti.300}",
        "onInfo":              "{primitive.color.ink.900}",
        "infoContainer":       "{primitive.color.entity.sti.800}",
        "onInfoContainer":     "{primitive.color.entity.sti.100}",
        "link":                "{entity.primary-dark}",
        "linkHover":           "{entity.200}",
        "focusRing":           "{entity.primary-dark}",
        "focusHalo":           "color-mix(in oklab, {entity.primary-dark} 28%, transparent)",
        "selectedBg":          "color-mix(in oklab, {entity.primary-dark} 12%, {primitive.color.ink.800})",
        "selectedBorder":      "{entity.primary-dark}",
        "scrim":               "color-mix(in oklab, {primitive.color.ink.900} 72%, transparent)",
        "inverseSurface":      "{primitive.color.ink.100}",
        "inverseOnSurface":    "{primitive.color.ink.900}",
        "inversePrimary":      "{entity.600}",
        "skeleton":            "{primitive.color.ink.700}",
        "skeletonShine":       "{primitive.color.ink.600}",
        "chartGrid":           "{primitive.color.ink.700}",
        "chartAxis":           "{primitive.color.ink.500}",
        "chartMuted":          "{primitive.color.ink.400}",
        "chartSurface":        "{primitive.color.ink.800}",
        "chartEmphasisDim":    "{primitive.color.ink.600}",
        "series1":             "{primitive.color.chart.1}",
        "series2":             "{primitive.color.chart.2}",
        "series3":             "{primitive.color.chart.3}",
        "series4":             "{primitive.color.chart.4}",
        "series5":             "{primitive.color.chart.5}",
        "series6":             "{primitive.color.chart.6}"
      }
    },
    "shadow": {
      "$description": "分层、单一光源（上方偏左）、色相取自宣纸墨色而非纯黑。暗色模式以描边 + 微光替代投影。",
      "light": {
        "none": "none",
        "xs": "0 1px 2px oklch(25% 0.02 60 / .06)",
        "sm": "0 1px 2px oklch(25% 0.02 60 / .06), 0 2px 6px -1px oklch(25% 0.02 60 / .07)",
        "md": "0 1px 2px oklch(25% 0.02 60 / .06), 0 4px 8px -2px oklch(25% 0.02 60 / .08), 0 12px 24px -8px oklch(25% 0.02 60 / .10)",
        "lg": "0 2px 4px oklch(25% 0.02 60 / .06), 0 8px 16px -4px oklch(25% 0.02 60 / .10), 0 24px 48px -12px oklch(25% 0.02 60 / .14)",
        "xl": "0 4px 8px oklch(25% 0.02 60 / .08), 0 16px 32px -8px oklch(25% 0.02 60 / .12), 0 48px 96px -24px oklch(25% 0.02 60 / .18)"
      },
      "dark": {
        "none": "none",
        "xs": "0 0 0 1px oklch(100% 0 0 / .05)",
        "sm": "0 0 0 1px oklch(100% 0 0 / .06), 0 2px 6px -1px oklch(0% 0 0 / .4)",
        "md": "0 0 0 1px oklch(100% 0 0 / .07), 0 8px 24px -8px oklch(0% 0 0 / .55)",
        "lg": "0 0 0 1px oklch(100% 0 0 / .08), 0 16px 40px -12px oklch(0% 0 0 / .65)",
        "xl": "0 0 0 1px oklch(100% 0 0 / .10), 0 32px 80px -20px oklch(0% 0 0 / .75)"
      }
    }
  },

  "component": {
    "$description": "Layer 2 · 组件 Token 只引用 Semantic。命名 --{component}-{property}[-{variant}]",
    "btn": {
      "height-xl": "48px", "height-l": "40px", "height-m": "36px", "height-s": "28px",
      "padx-xl": "{primitive.space.6}", "padx-l": "{primitive.space.5}", "padx-m": "20px", "padx-s": "14px",
      "fs-xl": "16px", "fs-l": "15px", "fs-m": "14px", "fs-s": "12px",
      "radius": "{primitive.radius.full}", "weight": "500", "gap": "{primitive.space.2}",
      "primary-bg": "{semantic.color.primary}", "primary-fg": "{semantic.color.onPrimary}",
      "primary-bg-hover": "{semantic.color.primaryHover}", "primary-bg-active": "{semantic.color.primaryActive}",
      "secondary-fg": "{semantic.color.primary}", "secondary-border": "{semantic.color.primary}", "secondary-bg-hover": "{semantic.color.primarySubtle}",
      "text-fg": "{semantic.color.primary}", "text-bg-hover": "{semantic.color.primarySubtle}",
      "danger-bg": "{semantic.color.error}", "danger-fg": "{semantic.color.onError}",
      "gold-bg": "{semantic.color.tertiary}", "gold-fg": "{semantic.color.onTertiary}",
      "ghost-fg": "{semantic.color.onSurface}", "ghost-border": "{semantic.color.outlineVariant}",
      "disabled-opacity": ".4", "hover-lift": "-1px", "active-scale": ".98",
      "focus-ring": "{semantic.color.focusRing}", "focus-halo": "{semantic.color.focusHalo}",
      "duration": "{primitive.motion.duration.fast}", "easing": "{primitive.motion.easing.out}"
